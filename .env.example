# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cha191_db
DB_USER=postgres
DB_PASSWORD=postgres_password

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d

# Hyperledger Fabric Blockchain Configuration
FABRIC_CHANNEL_NAME=ayushchannel
FABRIC_CHAINCODE_NAME=botanical_traceability
FABRIC_MSPID=Org1MSP
FABRIC_WALLET_PATH=./blockchain/wallet
FABRIC_CONNECTION_PROFILE=./blockchain/connection-org1.json

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
GEO_FENCE_STRICT_MODE=true

# Storage & Maps
MAPBOX_API_KEY=your_mapbox_api_key_here
OFFCHAIN_FILE_STORAGE_PATH=./uploads
